# Copy to backend/.env only if it does not exist, then replace this placeholder.
SECRET_KEY=change-me-generate-a-real-key-before-running
# Defaults to backend/data/app.db. Keep API and worker on the same database.
# DATABASE_URL=sqlite:////absolute/path/to/relayops/backend/data/app.db
ENVIRONMENT=production
REGISTRATION_ENABLED=false
COOKIE_SECURE=false
DASHBOARD_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
WEBHOOK_MAX_BYTES=1048576
WEBHOOK_READ_TIMEOUT=10
DELIVERY_TIMEOUT_SECONDS=15
DELIVERY_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=5
DEV_ALLOWED_ORIGINS=[]
